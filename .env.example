# You don't need to create this file by hand. `docker compose up -d` works
# fine with no .env at all; open the admin UI at http://localhost:8080 and
# follow the setup wizard, which creates your account and writes this file
# for you. This template is just a reference if you'd rather edit it directly.
#
# Note: Docker Compose treats a literal "$" in a value here as the start of a
# variable reference and silently strips it. If you're typing a value directly
# into this file and it contains "$", write it as "$$" instead. (Values edited
# through the admin web UI don't need this; the app escapes automatically.)

# ---------------------------------------------------------------------------
# Foundry VTT
# ---------------------------------------------------------------------------
# Docker image tag for the felddy/foundryvtt image itself, e.g. release, 12, 13
# (see https://github.com/felddy/foundryvtt-docker/pkgs/container/foundryvtt/versions)
FOUNDRY_CONTAINER_TAG=release

# Specific Foundry software version to install, e.g. 12.331, 13.345. Leave blank
# to use whatever version FOUNDRY_CONTAINER_TAG defaults to. Don't put an alias
# like "release" here; unlike FOUNDRY_CONTAINER_TAG, this goes straight to the
# entrypoint, which expects a concrete version number.
FOUNDRY_VERSION=

# Hostname baked into Foundry's config. Foundry ties license activation to this
# value, so don't change it casually once activated.
FOUNDRY_HOSTNAME=foundry

# Your license key from the Purchased Licenses page on foundryvtt.com, e.g.
# K3OX-MWZR-AH18-ZJHQ-ZAMO-SLNY. Installs and activates automatically on
# first boot. Leave blank to enter it by hand in Foundry's own setup screen
# instead.
FOUNDRY_LICENSE_KEY=

# Password required to reach Foundry's /setup admin screens. Required -
# leaving this unset means those screens are unprotected.
FOUNDRY_ADMIN_KEY=change-me

# Your foundryvtt.com account credentials. Used only at container startup to
# download the Foundry release tied to your license.
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=

# Optional: world folder name to launch automatically on boot. Leave blank to
# land on the setup screen instead.
FOUNDRY_WORLD=

# Optional: absolute path on this machine to bind-mount into Data/Mount, so
# its contents show up in Foundry's file picker without uploading them by
# hand, e.g. C:\Users\you\FoundryAssets or /home/you/foundry-assets. Must be
# absolute, not relative - see docs/configuration.md. Leave blank to skip.
FOUNDRY_ASSETS_PATH=

# Optional: language code plus the module that provides its translation,
# e.g. en.core (the default) or fr.core.
FOUNDRY_LANGUAGE=en.core

# Keep Foundry's own generated config across container restarts instead of
# regenerating it from the env vars above every time.
CONTAINER_PRESERVE_CONFIG=true

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (public access for players)
# ---------------------------------------------------------------------------
# Both of these can also be set from the admin UI's Foundry Settings wizard
# (its last step, "Cloudflare domain") once the stack is running. This template
# is here for editing directly before the first boot.
#
# Token for the tunnel you create in the Cloudflare Zero Trust dashboard
# (Networks > Tunnels > Create a tunnel > Cloudflared connector). The public
# hostname (e.g. dndwithfriends.com) is configured there too, as a "Public
# Hostname" on the tunnel pointing at http://nginx:80, not here. See
# docs/cloudflare-tunnel-setup.md for the full walkthrough.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: the hostname you configured in the dashboard, just so the admin UI
# can show/link it. Cosmetic only; changing this doesn't change what's tunneled.
PUBLIC_HOSTNAME=

# ---------------------------------------------------------------------------
# Admin UI account (config-ui) - LAN-accessible by default; see
# docs/cloudflare-tunnel-setup.md#exposing-the-admin-ui if you've
# deliberately routed it through a Cloudflare Access-gated subdomain instead
# ---------------------------------------------------------------------------
# These three are set by the setup wizard on first run, and after that by the
# dashboard's Account & Recovery panel. You shouldn't need to touch them
# directly; they're documented here in case you need to reset access manually.
# See docs/troubleshooting.md.
ADMIN_UI_USERNAME=
ADMIN_UI_PASSWORD_HASH=
FLASK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Password reset via email (optional, set from the dashboard)
# ---------------------------------------------------------------------------
# Where a "forgot password" reset code gets sent.
ADMIN_UI_RECOVERY_EMAIL=

# SMTP creds used to send that email. STARTTLS on port 587 is assumed (works
# for Gmail, Outlook, and most providers); implicit TLS on port 465 isn't
# supported. For Gmail, SMTP_PASSWORD needs to be an App Password, not your
# account password, which requires 2FA on the Google account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
